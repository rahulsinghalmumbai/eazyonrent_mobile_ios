<Project Sdk="Microsoft.NET.Sdk">

	<!-- ================= BASIC CONFIG ================= -->
	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
			$(TargetFrameworks);net8.0-windows10.0.19041.0
		</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>eazyonrent</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>eazyonrent</ApplicationTitle>
		<ApplicationId>com.ssharads.eazyonrent</ApplicationId>
		<AssemblyName>eazyonrent</AssemblyName>

		<!-- OS Versions -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- MacCatalyst -->
		<RuntimeIdentifiers Condition="'$(TargetFramework)'=='net9.0-maccatalyst'">
			maccatalyst-arm64;maccatalyst-x64
		</RuntimeIdentifiers>
	</PropertyGroup>
	<!-- macOS Catalyst specific configuration for HTTP support -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<MtouchHttpClientHandler>NSUrlSessionHandler</MtouchHttpClientHandler>
		<UseInterpreter>false</UseInterpreter>
		<MtouchLink>SdkOnly</MtouchLink>
		<CodesignEntitlements>Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>
	<!-- ================= RESOURCES ================= -->
<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<BundleResource Include="Platforms\MacCatalyst\Info.plist" />
	</ItemGroup>
	<ItemGroup>
		<!-- ANDROID / WINDOWS ICON ONLY -->
		 <MauiIcon Include="Resources\AppIcon\appicon.png" IsAppIcon="true" /> 
		<!-- Splash -->
		<MauiSplashScreen Include="Resources\Splash\splash.jpeg" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- ================= iOS ASSETS (CRITICAL) ================= -->
<!-- Include macOS specific files -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<BundleResource Include="Platforms\MacCatalyst\Info.plist" />
	</ItemGroup>
	<!-- iOS WILL ONLY LOOK FOR appicon.appiconset -->
	<ItemGroup Condition="'$(TargetFramework)'=='net9.0-ios'">
		<BundleResource Include="Platforms\iOS\Assets.xcassets\**\*" />
	</ItemGroup>


	<!-- ================= PACKAGES ================= -->

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Http.Features" Version="5.0.17" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
	</ItemGroup>

	<!-- ================= XAML ================= -->

	<ItemGroup>
		<MauiXaml Update="CustomControls\CustomToastControl.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\AddItemPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\BookItemPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\GuesPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\ItemDetails.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\LoginPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\UserChatPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\UserProfilePage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<!-- ================= ANDROID SIGNING ================= -->

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<ApplicationVersion>6</ApplicationVersion>
		<VersionCode>1</VersionCode>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>

		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>key.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>ReachConnect</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>raz#9540</AndroidSigningKeyPass>
		<AndroidSigningStorePass>raz#9540</AndroidSigningStorePass>
	</PropertyGroup>

	<!-- ================= iOS SIGNING ================= -->

	<PropertyGroup Condition="'$(TargetFramework)'=='net9.0-ios'">
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<CodesignKey>Apple Development: Created via API (MF33LFBC4B)</CodesignKey>
		<CodesignProvision>eazyonrent</CodesignProvision>
	
	<!-- ✅ ADDED: iOS Icon Specific Properties -->
		<AssetCatalogAppIconName>AppIcon</AssetCatalogAppIconName>
		<CreatePackage>false</CreatePackage>
		<GenerateBundle>false</GenerateBundle>
	</PropertyGroup>

	<!-- ================= MACCATALYST ================= -->

	<PropertyGroup Condition="'$(TargetFramework)'=='net9.0-maccatalyst'">
		<RuntimeIdentifier>maccatalyst-arm64</RuntimeIdentifier>
	
		<!-- ✅ ADDED: MacCatalyst Icon Properties -->
		<AssetCatalogAppIconName>AppIcon</AssetCatalogAppIconName>
	</PropertyGroup>

</Project>
