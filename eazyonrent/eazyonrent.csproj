<Project Sdk="Microsoft.NET.Sdk">

	<!-- ================= BASIC CONFIG ================= -->
	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<!--<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
			net10.0-android;net10.0-windows10.0.19041.0
		</TargetFrameworks>-->
		
		<TargetFrameworks>
    net10.0-android;
    net10.0-ios;
    net10.0-maccatalyst;
    net10.0-windows10.0.19041.0
  </TargetFrameworks>


		<OutputType>Exe</OutputType>
		<RootNamespace>eazyonrent</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>eazyonrent</ApplicationTitle>
		<ApplicationId>com.ssharads.eazyonrent</ApplicationId>

		<AssemblyName>eazyonrent</AssemblyName>

		<!-- OS Versions -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- MacCatalyst -->
		<RuntimeIdentifiers Condition="'$(TargetFramework)'=='net10.0-maccatalyst'">
			maccatalyst-arm64;maccatalyst-x64
		</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- ================= WINDOWS SAFETY FIX ================= -->
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
		<EnableIOS>false</EnableIOS>
	</PropertyGroup>

	<!-- macOS Catalyst specific configuration for HTTP support -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<MtouchHttpClientHandler>NSUrlSessionHandler</MtouchHttpClientHandler>
		<UseInterpreter>false</UseInterpreter>
		<MtouchLink>SdkOnly</MtouchLink>
		<CodesignEntitlements>Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<!-- ================= RESOURCES ================= -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<BundleResource Include="Platforms\MacCatalyst\Info.plist" />
	</ItemGroup>

	<ItemGroup>
		<!-- ANDROID / WINDOWS ICON ONLY -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" IsAppIcon="true" />
		<!-- Splash -->
		<MauiSplashScreen Include="Resources\Splash\splash.jpeg" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- ================= iOS ASSETS (CRITICAL) ================= -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<BundleResource Include="Platforms\MacCatalyst\Info.plist" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
		<BundleResource Include="Platforms\iOS\Assets.xcassets\**\*" />
	</ItemGroup>

	<!-- ================= PACKAGES ================= -->
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Http.Features" Version="5.0.17" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
	</ItemGroup>

	<!-- ================= XAML ================= -->
	<ItemGroup>
		<MauiXaml Update="CustomControls\CustomToastControl.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\AddItemPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
		<MauiXaml Update="Pages\BookItemPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
		<MauiXaml Update="Pages\EditItemPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\GuesPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
		<MauiXaml Update="Pages\ItemDetails.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
		<MauiXaml Update="Pages\LoginPage.
				  
		Xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
		<MauiXaml Update="Pages\UserChatPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
		<MauiXaml Update="Pages\UserProfilePage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	</ItemGroup>

	<!-- ================= ANDROID SIGNING ================= -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<ApplicationVersion>6</ApplicationVersion>
		<VersionCode>1</VersionCode>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>

		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>key.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>ReachConnect</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>raz#9540</AndroidSigningKeyPass>
		<AndroidSigningStorePass>raz#9540</AndroidSigningStorePass>
	</PropertyGroup>

	<!-- ================= iOS SIGNING ================= -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' AND '$(Configuration)'=='Debug'">
		<RuntimeIdentifier>iossimulator-x64</RuntimeIdentifier>
		<ApplicationId>com.ssharads.eazyonrent</ApplicationId>
		<MtouchLink>SdkOnly</MtouchLink>
	</PropertyGroup>
<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
  <AssetCatalogAppIconName>appicon</AssetCatalogAppIconName>
</PropertyGroup>
	
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' AND '$(Configuration)'=='Release'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
	  <AssetCatalogAppIconName>appicon</AssetCatalogAppIconName>
		<ApplicationVersion>2</ApplicationVersion>
		<VersionCode>2</VersionCode>
		<ApplicationDisplayVersion>1.0.2</ApplicationDisplayVersion>
    <ApplicationId>com.ssharads.eazyonrent</ApplicationId>
    <CodesignKey>Apple Distribution: Ssharad Mittal (DT8372ZT8Y)</CodesignKey>
    <CodesignProvision>EazyOnRentAppleDist</CodesignProvision>
    <BuildIpa>true</BuildIpa>
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchUseLlvm>true</MtouchUseLlvm>
    <IpaPackageName>eazyonrent.ipa</IpaPackageName>
  </PropertyGroup>


	<!-- ================= MACCATALYST ================= -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-maccatalyst'">
		<RuntimeIdentifier>maccatalyst-arm64</RuntimeIdentifier>
		<AssetCatalogAppIconName>AppIcon</AssetCatalogAppIconName>
	</PropertyGroup>

</Project>
