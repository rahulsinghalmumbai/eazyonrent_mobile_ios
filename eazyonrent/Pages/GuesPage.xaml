                    <Label Text="Search" 
              FontSize="10" 
              HorizontalOptions="Center" 
              TextColor="{AppThemeBinding Light=#666, Dark=#AAAAAA}"
              FontAttributes="Bold"/>
                </StackLayout>

                <!--Add Item Button (Center/Plus Button)-->
