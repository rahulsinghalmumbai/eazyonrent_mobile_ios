<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eazyonrent.Pages.EditItemPage"
             Title="Edit Item"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1C1C1E}">

	<ScrollView Padding="20">
		<VerticalStackLayout Spacing="20">

			<!-- IMAGE SECTION -->
			<Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"
                   CornerRadius="10"
                   HasShadow="True"
                   Padding="12"
                   BorderColor="{AppThemeBinding Light=Gray, Dark=#444444}">

				<VerticalStackLayout Spacing="10">

					<!-- Top row: Add Image button + count badge -->
					<Grid ColumnDefinitions="*, Auto">
						<Button Grid.Column="0"
                                x:Name="CameraButton"
                                Text="📷  Add Image"
                                FontSize="15"
                                FontAttributes="Bold"
                                BackgroundColor="#4a6fc7"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="45"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnCameraClicked"/>

						<Frame Grid.Column="1"
                               x:Name="ImageCountBadge"
                               IsVisible="False"
                               BackgroundColor="#28A745"
                               CornerRadius="12"
                               Padding="10,4"
                               HasShadow="False"
                               Margin="8,0,0,0"
                               VerticalOptions="Center">
							<Label x:Name="ImageCountLabel"
                                   Text="0 images"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
						</Frame>
					</Grid>

					<!-- Empty state -->
					<StackLayout x:Name="EmptyImagePlaceholder"
                                 IsVisible="True"
                                 HorizontalOptions="Center"
                                 Spacing="4">
						<Label Text="No images selected"
                               FontSize="13"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#999, Dark=#777777}"/>
						<Label Text="Tap 'Add Image' to pick from camera or gallery"
                               FontSize="11"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#BBBBBB, Dark=#555555}"/>
					</StackLayout>

					<!-- Image Cards CollectionView -->
