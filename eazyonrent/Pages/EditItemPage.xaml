<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eazyonrent.Pages.EditItemPage"
             Title="Edit Item"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1C1C1E}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <!-- Category Selection -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                   CornerRadius="15"
                   HasShadow="True"
                   Padding="5"
                   BorderColor="{AppThemeBinding Light=LightGray, Dark=#444444}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                    <Picker x:Name="CategoryPicker"
                            ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding CategoriesName}"
                            SelectedItem="{Binding SelectedCategory}"
                            BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#3A3A3C}"
                            TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Name Field -->
            <StackLayout Spacing="8">
                <Label Text="Name"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Frame BorderColor="{AppThemeBinding Light=Gray, Dark=#555555}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                       CornerRadius="8"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="NameEntry"
                           Placeholder="Enter item name"
                           PlaceholderColor="{AppThemeBinding Light=#999, Dark=#777777}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           HeightRequest="45"/>
                </Frame>
            </StackLayout>

            <!-- Company Name Field -->
            <StackLayout Spacing="8">
                <Label Text="Company Name"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Frame BorderColor="{AppThemeBinding Light=Gray, Dark=#555555}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                       CornerRadius="8"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="CompanyNameEntry"
                           Placeholder="Enter company name"
                           PlaceholderColor="{AppThemeBinding Light=#999, Dark=#777777}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           HeightRequest="45"/>
                </Frame>
            </StackLayout>

            <!-- Price Field -->
            <StackLayout Spacing="8">
                <Label Text="Price"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Frame BorderColor="{AppThemeBinding Light=Gray, Dark=#555555}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                       CornerRadius="8"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="PriceEntry"
                           Placeholder="Enter price"
                           PlaceholderColor="{AppThemeBinding Light=#999, Dark=#777777}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           Keyboard="Numeric"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           HeightRequest="45"/>
                </Frame>
            </StackLayout>

            <!-- Description Field -->
            <StackLayout Spacing="8">
                <Label Text="Description"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Frame BorderColor="{AppThemeBinding Light=Gray, Dark=#555555}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                       CornerRadius="8"
                       Padding="0"
                       HasShadow="False">
                    <Entry x:Name="DescriptionEntry"
                           Placeholder="Enter item description"
                           PlaceholderColor="{AppThemeBinding Light=#999, Dark=#777777}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           HeightRequest="45"/>
                </Frame>
            </StackLayout>

            <!-- Available From Field -->
            <StackLayout Spacing="8">
                <Label Text="Available From"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Frame BorderColor="{AppThemeBinding Light=Gray, Dark=#555555}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                       CornerRadius="8"
                       Padding="8"
                       HasShadow="False">
                    <DatePicker x:Name="AvailableFromPicker"
                                Format="dd-MMM-yyyy"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                BackgroundColor="Transparent"/>
                </Frame>
            </StackLayout>

            <!-- Status Field -->
            <StackLayout Spacing="8">
                <Label Text="Status"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Frame BorderColor="{AppThemeBinding Light=Gray, Dark=#555555}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                       CornerRadius="8"
                       Padding="0"
                       HasShadow="False">
                    <Picker x:Name="StatusPicker"
                            Title="Select Status"
                            FontSize="14"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            TitleColor="{AppThemeBinding Light=#999, Dark=#777777}"
                            BackgroundColor="Transparent">
                        <Picker.Items>
                            <x:String>Active</x:String>
                            <x:String>Inactive</x:String>
                            <x:String>Pending</x:String>
                        </Picker.Items>
                    </Picker>
                </Frame>
            </StackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#4a6fc7"
                               HeightRequest="40"/>

            <!-- Update Button -->
            <Button x:Name="UpdateButton"
                    Text="Update Item"
                    BackgroundColor="#4a6fc7"
                    TextColor="White"
                    CornerRadius="10"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Margin="0,20,0,0"
                    Clicked="OnUpdateClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>